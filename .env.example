# Environment variables for Legal Advisory System

# Anthropic Claude API Key (required)
# Get yours from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flask secret key (change this to a random string in production)
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Flask environment (development / production)
FLASK_ENV=development

# Port to run the application on (default: 5000)
PORT=5000
